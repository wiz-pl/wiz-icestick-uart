import Icestick.Gates
-- An 8N1 UART: a baud divider, a transmitter and a receiver, as step functions over
-- bundles (structures of signals), and as circuits. `n` is the number of clock cycles per
-- bit, a meta-level `Nat`: it only ends up in the netlist as the constants the counters
-- are compared with.
--
-- On the iCEstick: 12 MHz / 104 = 115384.6 baud, 0.16 % above 115200.

------------------------------------------------------------------------------------
-- The baud divider: a 7-bit counter that counts 0 … n-1; `tick` is high in the last
-- cycle of each period. (`Icestick.Proofs` shows that its period is exactly `n`.)

def baudStep {r : HwTy → Type} [Hw r] (n : Nat) (c : r B7) : r (HwTy.prod B7 Bit) :=
  let t := Hw.label "tick" (c === Hw.ofNat (n - 1));
  Hw.pair (if t then 0 else c + 1) t

------------------------------------------------------------------------------------
-- The transmitter. State: the line (a register of its own, so the pin is driven by a
-- flip-flop and cannot glitch), the number of bit periods left (0: idle), the baud
-- counter, and a 9-bit shift register (stop bit on top of the data, least significant
-- bit first; ones are shifted in).
--
-- `start` with `data` is taken when idle and ignored otherwise.

structure Tx (r : HwTy → Type) where
  line : r Bit
  left : r B4
  cnt : r B7
  sh : r B9
  deriving Bundle

def Tx.init : Tx HwTy.El := Tx.mk (BitVec.ofNat 1 1) (BitVec.ofNat 4 0) (BitVec.ofNat 7 0) (BitVec.ofNat 9 511)

def txIdle {r : HwTy → Type} [Hw r] (s : Tx r) : r Bit := s.left === 0

def txStep {r : HwTy → Type} [Hw r] (n : Nat) (s : Tx r) (start : r Bit) (d : r B8) : r Tx.code :=
  let idle := txIdle s;
  let go := idle &&& start;
  let b := baudStep n s.cnt;
  let tick := ~~~idle &&& Hw.snd b;
  Tx.pack (Tx.mk
    (if go then 0 else if tick then Hw.slice 0 1 s.sh else s.line)
    (if go then 10 else if tick then s.left - 1 else s.left)
    (if go then 0 else Hw.fst b)
    (if go then frame9 d else if tick then shiftIn9 s.sh hi else s.sh))

------------------------------------------------------------------------------------
-- The receiver. State: the phase (0: idle, 10: in the start bit, 9 … 2: data bits,
-- 1: stop bit), the baud counter and the shift register.
--
-- A low line when idle starts a frame; half a bit later the line must still be low
-- (otherwise it was a glitch), and from there the line is sampled once per bit period,
-- i.e. in the middle of each bit. `valid` is high for one cycle, at the sample of a
-- stop bit that is high, and `data` is the byte then.

structure Rx (r : HwTy → Type) where
  ph : r B4
  cnt : r B7
  sh : r B8
  deriving Bundle

structure Byte (r : HwTy → Type) where
  valid : r Bit
  data : r B8
  deriving Bundle

def Rx.init : Rx HwTy.El := Rx.mk (BitVec.ofNat 4 0) (BitVec.ofNat 7 0) (BitVec.ofNat 8 0)

def rxStep {r : HwTy → Type} [Hw r] (n : Nat) (s : Rx r) (rx : r Bit) : r (HwTy.prod Rx.code Byte.code) :=
  let idle := s.ph === 0;
  let inStart := s.ph === 10;
  let inStop := s.ph === 1;
  let fall := idle &&& ~~~rx;
  let startTick := inStart &&& s.cnt === Hw.ofNat (Nat.div n 2 - 1);
  let tick := ~~~idle &&& (~~~inStart &&& s.cnt === Hw.ofNat (n - 1));
  let ph := if fall then 10
    else if startTick then (if rx then 0 else 9) else if tick then s.ph - 1 else s.ph;
  let cnt := if fall ||| (startTick ||| tick) then 0 else s.cnt + 1;
  let sh := if tick &&& ~~~inStop then shiftIn8 s.sh rx else s.sh;
  Hw.pair (Rx.pack (Rx.mk ph cnt sh)) (Byte.pack (Byte.mk (tick &&& (inStop &&& rx)) s.sh))

------------------------------------------------------------------------------------
-- The input synchroniser: the RX pin is asynchronous to the clock, so it goes through
-- two flip-flops before anything looks at it. Both idle high.

structure Sync (r : HwTy → Type) where
  ff1 : r Bit
  ff2 : r Bit
  deriving Bundle

def Sync.init : Sync HwTy.El := Sync.mk (BitVec.ofNat 1 1) (BitVec.ofNat 1 1)
def syncStep {r : HwTy → Type} [Hw r] (s : Sync r) (pin : r Bit) : r Sync.code := Sync.pack (Sync.mk pin s.ff1)

------------------------------------------------------------------------------------
-- The same parts as circuits, for composition: the transmitter (input: start and the
-- byte; output: the line), the synchroniser, the receiver (output: valid and the byte).

structure Send (r : HwTy → Type) where
  start : r Bit
  data : r B8
  deriving Bundle
structure Line (r : HwTy → Type) where
  line : r Bit
  deriving Bundle

def txC (n : Nat) : Circuit Send.code Line.code :=
  Circuit.bundled Tx.bundle Send.bundle Line.bundle Tx.init
    (fun s x => Hw.pair (txStep n s x.start x.data) (Line.pack (Line.mk s.line)))
def syncC : Circuit Line.code Line.code :=
  Circuit.bundled Sync.bundle Line.bundle Line.bundle Sync.init
    (fun s x => Hw.pair (syncStep s x.line) (Line.pack (Line.mk s.ff2)))
def rxC (n : Nat) : Circuit Line.code Byte.code :=
  Circuit.bundled Rx.bundle Line.bundle Byte.bundle Rx.init (fun s x => rxStep n s x.line)
