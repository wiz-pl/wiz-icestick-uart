import Icestick.Fx
-- The demo: the OLED controller (`Icestick.Oled`) streaming the effects
-- (`Icestick.Fx`), the LEDs in time with them, and a one-key prompt on the serial port.
--
-- Serial port (115200 8N1): `1` … `4` keeps that effect on the screen (plasma, stars,
-- scroller, XOR), `0` goes back to the sequence. Nothing is sent back.
-- LEDs: LED1 … LED4 the effect on the screen, pulsing with a sine of the frame counter
-- (pulse-width modulated); LED5 (green) on once the display is on.
--
-- Pins (`OledBoard`, `Oled.pins` in `Icestick.OledSim`): the Pmod connector J2, wired
-- as a Digilent PmodOLED expects (its pin 1 on J2's pin 1).

structure OledPins (r : HwTy → Type) where
  uart_rx : r Bit
  deriving Bundle

structure OledBoard (r : HwTy → Type) where
  uart_tx : r Bit
  leds : r B5
  oled_cs : r Bit       -- CS, low: selected
  oled_mosi : r Bit     -- SDIN
  oled_sclk : r Bit     -- SCLK
  oled_dc : r Bit       -- D/C, low: command
  oled_res : r Bit      -- RES, low: reset
  oled_vbatc : r Bit    -- VBATC, low: panel supply on
  oled_vddc : r Bit     -- VDDC, low: logic supply on
  deriving Bundle

structure Demo (fl : Nat) (r : HwTy → Type) where
  ctl : Ctl fl r
  sync : Sync r
  rx : Rx r
  lock : r Bit
  sel : r D2
  deriving Bundle

def Demo.init (c : OledCfg) : Demo c.frameLog HwTy.El :=
  Demo.mk (Ctl.init c) Sync.init Rx.init (BitVec.ofNat 1 0) (BitVec.ofNat 2 0)

def demoStep {r : HwTy → Type} [Hw r] (c : OledCfg) (n : Nat) (rom : RomT) (s : Demo c.frameLog r) (x : OledPins r)
    : r (HwTy.prod (Demo.code c.frameLog) OledBoard.code) :=
  let cs := s.ctl;
  let t := cs.t;
  let e := Hw.mux s.lock s.sel (Hw.slice 9 2 t);
  let lt := Hw.slice 0 9 t;
  let pix := demoPixel c.rows e (Gen.x cs.gen) (Gen.y cs.gen) lt;
  -- the key: 48 … 52 ('0' … '4')
  let rr := rxStep n s.rx s.sync.ff2;
  let got := Byte.unpack (Hw.snd rr);
  let d := got.data;
  let digit := band got.valid (band (eqLit (Hw.slice 3 5 d) 6) (Hw.ult (Hw.slice 0 3 d) (Hw.lit 3 5)));
  -- the LEDs: brightness 0 … 15 against the low bits of the frame timer
  let level := Hw.slice 1 4 (sin6 (Hw.cat (Hw.slice 0 5 t) lo));
  let on := Hw.ult (Hw.slice 0 4 cs.timer) level;
  let oneHot := Hw.cat (band (eqLit e 3) on) (Hw.cat (band (eqLit e 2) on) (Hw.cat (band (eqLit e 1) on) (band (eqLit e 0) on)));
  Hw.pair
    (Demo.pack c.frameLog (Demo.mk (Ctl.unpack c.frameLog (ctlStep c rom cs pix))
      (Sync.unpack (syncStep s.sync x.uart_rx)) (Rx.unpack (Hw.fst rr))
      (Hw.mux digit (bnot (eqLit (Hw.slice 0 3 d) 0)) s.lock)
      (Hw.mux digit (dec (Hw.slice 0 2 d)) s.sel)))
    (OledBoard.pack (OledBoard.mk hi (Hw.cat (ctlShowing c cs) oneHot)
      cs.cs cs.spi.mosi cs.spi.sclk cs.dc cs.res cs.vbat cs.vdd))

-- `n`: clock cycles per bit of the serial port
def demo (c : OledCfg) (n : Nat) : Circuit OledPins.code OledBoard.code :=
  let rom := Prog.tree c;
  Circuit.bundled (Demo.bundle c.frameLog) OledPins.bundle OledBoard.bundle (Demo.init c) (demoStep c n rom)
