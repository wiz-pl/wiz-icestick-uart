import Icestick.Uart
import Icestick.Crc
-- The designs. Each is a `Circuit Bit B6` for the same board pins: the input is the
-- UART RX pin, the output bus is the five LEDs (bits 5 … 1: LED5 … LED1) on top of the
-- UART TX pin (bit 0). `n` is the number of clock cycles per UART bit.

def B24 : HwTy := HwTy.bits 24

-- Each design is a `Circuit Pins.code Board.code`: the input is the UART RX pin
-- (`uart_rx`), the outputs are the UART TX pin (`uart_tx`) and the five LEDs (`leds`).

------------------------------------------------------------------------------------
-- 1. blinky: a 24-bit counter, its top five bits on the LEDs (LED5 blinks at
--    12 MHz / 2^24 = 0.72 Hz). The TX line idles high.

def blinky : Circuit Pins.code Board.code :=
  Circuit.mk (HwTy.named "count" B24) (BitVec.ofNat 24 0)
    (fun s x => Hw.pair (Hw.tag "count" (inc (Hw.untag s))) (board (Hw.slice 19 5 (Hw.untag s)) hi))

------------------------------------------------------------------------------------
-- 2. hello: send a fixed string, wait 2^g cycles, again. The LEDs show the index.

def helloText : List Nat :=   -- "Hello from Wiz!\r\n"
  .cons 72 (.cons 101 (.cons 108 (.cons 108 (.cons 111 (.cons 32 (.cons 102 (.cons 114
  (.cons 111 (.cons 109 (.cons 32 (.cons 87 (.cons 105 (.cons 122 (.cons 33 (.cons 13
  (.cons 10 .nil))))))))))))))))

structure Hello (g : Nat) (r : HwTy → Type) where
  tx : Tx r
  idx : r B5
  timer : r (HwTy.bits g)
  deriving Bundle

def helloStep {r : HwTy → Type} [Hw r] (n g : Nat) (s : Hello g r) : r (HwTy.prod (Hello.code g) Board.code) :=
  let sending := Hw.ult s.idx (Hw.lit 5 (List.length helloText));
  let go := band sending (txIdle s.tx);
  let again := band (bnot sending) (eqLit s.timer (Nat.pow 2 g - 1));
  Hw.pair
    (Hello.pack g (Hello.mk (Tx.unpack (txStep n s.tx go (rom s.idx 0 helloText)))
      (Hw.mux go (inc s.idx) (Hw.mux again (Hw.lit 5 0) s.idx))
      (Hw.mux sending (Hw.lit g 0) (inc s.timer))))
    (board s.idx s.tx.line)

def hello (n g : Nat) : Circuit Pins.code Board.code :=
  Circuit.bundled (Hello.bundle g) Pins.bundle Board.bundle (Hello.mk Tx.init (BitVec.ofNat 5 0) (BitVec.ofNat g 0))
    (BStep.mk (fun s x => helloStep n g s))

------------------------------------------------------------------------------------
-- 3. echo: every byte received is sent back. One byte can wait while the transmitter
--    is busy. The LEDs show the low five bits of the last byte.

structure Echo (r : HwTy → Type) where
  sync : Sync r
  rx : Rx r
  tx : Tx r
  pending : r Bit
  byte : r B8
  deriving Bundle

def echoStep {r : HwTy → Type} [Hw r] (n : Nat) (s : Echo r) (x : Pins r) : r (HwTy.prod Echo.code Board.code) :=
  let rr := rxStep n s.rx s.sync.ff2;
  let got := Byte.unpack (Hw.snd rr);
  let send := band s.pending (txIdle s.tx);
  Hw.pair
    (Echo.pack (Echo.mk (Sync.unpack (syncStep s.sync x.uart_rx)) (Rx.unpack (Hw.fst rr))
      (Tx.unpack (txStep n s.tx send s.byte))
      (Hw.mux got.valid hi (Hw.mux send lo s.pending))
      (Hw.mux got.valid got.data s.byte)))
    (board (Hw.slice 0 5 s.byte) s.tx.line)

def echo (n : Nat) : Circuit Pins.code Board.code :=
  Circuit.bundled Echo.bundle Pins.bundle Board.bundle
    (Echo.mk Sync.init Rx.init Tx.init (BitVec.ofNat 1 0) (BitVec.ofNat 8 0)) (BStep.mk (fun s x => echoStep n s x))

------------------------------------------------------------------------------------
-- 4. proto: a CRC service. The host sends a line (any bytes but 0x0A, then 0x0A); the
--    device answers the CRC-8 of the line's bytes as two upper-case hexadecimal digits
--    and 0x0A. LED1 … LED4 count the lines, LED5 is on.
--
--    State: the CRC so far, the CRC being reported, the reply phase (0: none; 1, 2:
--    the digits; 3: the newline) and the line counter. The host must wait for the
--    answer before it ends the next line.

structure Proto (r : HwTy → Type) where
  sync : Sync r
  rx : Rx r
  tx : Tx r
  crc : r B8
  hold : r B8
  phase : r B2
  lines : r B4
  deriving Bundle

def protoStep {r : HwTy → Type} [Hw r] (n : Nat) (s : Proto r) (x : Pins r) : r (HwTy.prod Proto.code Board.code) :=
  let rr := rxStep n s.rx s.sync.ff2;
  let got := Byte.unpack (Hw.snd rr);
  let isNl := eqLit got.data 10;
  let endLine := band got.valid isNl;
  let dataByte := band got.valid (bnot isNl);
  let send := band (bnot (eqLit s.phase 0)) (txIdle s.tx);
  let ch := Hw.mux (eqLit s.phase 1) (hexDigit (Hw.slice 4 4 s.hold))
    (Hw.mux (eqLit s.phase 2) (hexDigit (Hw.slice 0 4 s.hold)) (Hw.lit 8 10));
  Hw.pair
    (Proto.pack (Proto.mk (Sync.unpack (syncStep s.sync x.uart_rx)) (Rx.unpack (Hw.fst rr))
      (Tx.unpack (txStep n s.tx send ch))
      (Hw.mux endLine (Hw.lit 8 0) (Hw.mux dataByte (crcStep s.crc got.data) s.crc))
      (Hw.mux endLine s.crc s.hold)
      (Hw.mux endLine (Hw.lit 2 1) (Hw.mux send (inc s.phase) s.phase))
      (Hw.mux endLine (inc s.lines) s.lines)))
    (board (Hw.cat (Hw.lit 1 1 : r (HwTy.bits 1)) s.lines) s.tx.line)

def proto (n : Nat) : Circuit Pins.code Board.code :=
  Circuit.bundled Proto.bundle Pins.bundle Board.bundle
    (Proto.mk Sync.init Rx.init Tx.init (BitVec.ofNat 8 0) (BitVec.ofNat 8 0) (BitVec.ofNat 2 0) (BitVec.ofNat 4 0))
    (BStep.mk (fun s x => protoStep n s x))

------------------------------------------------------------------------------------
-- Not for the board: pieces on their own, for the proofs and the tests.

-- the baud divider alone: no input, the tick as output
def baud (n : Nat) : Circuit (HwTy.bits 0) Bit := Circuit.mk B7 (BitVec.ofNat 7 0) (fun s u => baudStep n s)

-- a transmitter wired to a receiver through the synchroniser:
-- input (start, byte), output (valid, byte)
def loopback (n : Nat) : Circuit Send.code Byte.code := Circuit.seq (txC n) (Circuit.seq syncC (rxC n))

-- the clock divider of the board: 12 MHz / 104 = 115384.6 baud
def clocksPerBit : Nat := 104
