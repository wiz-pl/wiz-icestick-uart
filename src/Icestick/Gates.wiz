import Hdl.Core
-- Small vocabulary on top of `Hdl.Core`'s `Hw` operations, shared by every design here.
-- Everything is polymorphic in the representation `r`, so it simulates (`HwTy.El`) and
-- synthesises (`Wire`) from the same text.

def Bit : HwTy := HwTy.bits 1
def B2 : HwTy := HwTy.bits 2
def B3 : HwTy := HwTy.bits 3
def B4 : HwTy := HwTy.bits 4
def B5 : HwTy := HwTy.bits 5
def B7 : HwTy := HwTy.bits 7
def B8 : HwTy := HwTy.bits 8
def B9 : HwTy := HwTy.bits 9

def hi {r : HwTy → Type} [Hw r] : r Bit := Hw.lit 1 1
def lo {r : HwTy → Type} [Hw r] : r Bit := Hw.lit 1 0

-- Shift registers, least significant bit first: `b` comes in at the top.
def frame9 {r : HwTy → Type} [Hw r] (d : r B8) : r B9 := Hw.cat (Hw.lit 1 1) d
def shiftIn9 {r : HwTy → Type} [Hw r] (x : r B9) (b : r Bit) : r B9 := Hw.cat b (Hw.slice 1 8 x)
def shiftIn8 {r : HwTy → Type} [Hw r] (x : r B8) (b : r Bit) : r B8 := Hw.cat b (Hw.slice 1 7 x)

def shl1 {r : HwTy → Type} [Hw r] (c : r B8) : r B8 := Hw.cat (Hw.slice 0 7 c) (Hw.lit 1 0)

-- A read-only memory as a chain of multiplexers: entry `k` of the list at index `k`
-- (a meta-level recursion: the list is gone from the netlist, only constants remain).
def rom {r : HwTy → Type} [Hw r] (idx : r B5) : Nat → List Nat → r B8
  | _, .nil => Hw.lit 8 0
  | k, .cons c cs => if idx === Hw.ofNat k then Hw.ofNat c else rom idx (Nat.succ k) cs

------------------------------------------------------------------------------------
-- The board's pins, as bundles: the module's ports are `uart_rx`, `uart_tx` and `leds`
-- (LED1 … LED5 = bits 0 … 4).

structure Pins (r : HwTy → Type) where
  uart_rx : r Bit
  deriving Bundle

structure Board (r : HwTy → Type) where
  uart_tx : r Bit
  leds : r B5
  deriving Bundle

def board {r : HwTy → Type} [Hw r] (line : r Bit) (leds : r B5) : r Board.code := Board.pack (Board.mk line leds)
