import Icestick.Designs
import Icestick.Wave
-- The board (Lattice iCEstick, iCE40HX1K-TQ144) and the files the tools want: the pin
-- constraints, a Verilog test bench that replays a trace, and the trace.

-- Pin numbers as in icestorm's examples/icestick/icestick.pcf (clk 21, RX 9, TX 8,
-- LED1 … LED5 = 99 … 95). `Verilog.emit` names the ports `clk`, `x` (the input bus)
-- and `y` (the output bus); see `Icestick.Designs` for the bits of `y`.
def Board.pcf : String :=
  "# Lattice iCEstick (iCE40HX1K-TQ144); generated by `icestick gen`\n" <+>
  "set_io clk 21\n" <+>      -- 12 MHz oscillator
  "set_io x 9\n" <+>         -- UART RX: FT2232H channel B TXD -> FPGA
  "set_io y[0] 8\n" <+>      -- UART TX: FPGA -> FT2232H channel B RXD
  "set_io y[1] 99\n" <+>     -- LED1 (red)
  "set_io y[2] 98\n" <+>     -- LED2 (red)
  "set_io y[3] 97\n" <+>     -- LED3 (red)
  "set_io y[4] 96\n" <+>     -- LED4 (red)
  "set_io y[5] 95\n"         -- LED5 (green)

-- A test bench for a module `name` made by `Verilog.emit` from a `Circuit Bit B6`: it
-- reads `cycles` vectors (7 bits each: the input on top of the expected output) from
-- `vec`, and in each cycle sets the input, compares the output and clocks.
def Board.testbench (name vec : String) (cycles : Nat) : String :=
  "`timescale 1ns/1ps\n" <+>
  "module tb;\n" <+>
  "  reg clk = 0;\n" <+>
  "  reg [0:0] x = 1;\n" <+>
  "  wire [5:0] y;\n" <+>
  "  " <+> name <+> " dut(.clk(clk), .x(x), .y(y));\n" <+>
  "  reg [6:0] vec [0:" <+> Nat.show (cycles - 1) <+> "];\n" <+>
  "  integer i, errors;\n" <+>
  "  initial begin\n" <+>
  "    $readmemh(\"" <+> vec <+> "\", vec);\n" <+>
  "    errors = 0;\n" <+>
  "    for (i = 0; i < " <+> Nat.show cycles <+> "; i = i + 1) begin\n" <+>
  "      x = vec[i][6];\n" <+>
  "      #1;\n" <+>
  "      if (y !== vec[i][5:0]) begin\n" <+>
  "        errors = errors + 1;\n" <+>
  "        if (errors < 10) $display(\"mismatch at cycle %0d: got %b, expected %b\", i, y, vec[i][5:0]);\n" <+>
  "      end\n" <+>
  "      clk = 1; #1; clk = 0; #1;\n" <+>
  "    end\n" <+>
  "    if (errors == 0) $display(\"PASS " <+> name <+> ": %0d cycles\", i);\n" <+>
  "    else $display(\"FAIL " <+> name <+> ": %0d mismatches\", errors);\n" <+>
  "    $finish;\n" <+>
  "  end\n" <+>
  "endmodule\n"

def Hex.digit (n : Nat) : Char := match Nat.lt n 10 with
  | .true => Char.mk (48 + n)
  | .false => Char.mk (87 + n)

-- One vector per line, two hexadecimal digits: input * 64 + output. `k` vectors at a
-- time, so that a long trace is written in pieces.
def Vec.chunk : Nat → List Nat → List Nat → List Char → List Char × (List Nat × List Nat)
  | .zero, xs, ys, acc => (List.reverseAux acc .nil, (xs, ys))
  | .succ k, .cons x xs, .cons y ys, acc =>
    Vec.chunk k xs ys
      (List.cons (Char.mk 10) (List.cons (Hex.digit (Nat.mod (x * 64 + y) 16))
        (List.cons (Hex.digit (Nat.div (x * 64 + y) 16)) acc)))
  | .succ k, xs, ys, acc => (List.reverseAux acc .nil, (.nil, .nil))

------------------------------------------------------------------------------------
-- The scenarios: for each design, what the host does and what must come back.

-- (A `Circuit` lives in `Type 1`, so it cannot be a field of something kept in a
--  `List`: the designs are named by an enumeration instead. See FINDINGS.md.)
inductive Design where
  | blinky
  | hello
  | echo
  | proto

def Design.name : Design → String
  | .blinky => "blinky"
  | .hello => "hello"
  | .echo => "echo"
  | .proto => "proto"

def Design.circuit : Design → Circuit Bit B6
  | .blinky => blinky
  | .hello => hello clocksPerBit 22
  | .echo => echo clocksPerBit
  | .proto => proto clocksPerBit

def Design.all : List Design := .cons .blinky (.cons .hello (.cons .echo (.cons .proto .nil)))

def Design.netlist (d : Design) : Netlist := Circuit.netlist (Design.name d) (Design.circuit d)

-- `Verilog.emit` of Hdl.Core, with two repairs (FINDINGS.md, "Verilog: use before
-- declaration" and "unsized initial value"): the register updates come after the
-- wires they read, and the initial values are sized.
def Emit.regDecls : Nat → List Reg → String
  | _, .nil => ""
  | k, .cons r rs => "  reg " <+> Verilog.range r.width <+> "r" <+> Nat.show k <+> "; initial r" <+> Nat.show k
      <+> " = " <+> Nat.show (Nat.max r.width 1) <+> "'d" <+> Nat.show r.init <+> ";\n" <+> Emit.regDecls (Nat.succ k) rs
def Emit.regUpdates : Nat → List Reg → String
  | _, .nil => ""
  | k, .cons r rs => "  always @(posedge clk) r" <+> Nat.show k <+> " <= " <+> Verilog.node r.next <+> ";\n"
      <+> Emit.regUpdates (Nat.succ k) rs
def Emit.verilog (n : Netlist) : String :=
  "module " <+> n.name <+> "(input clk" <+> Verilog.ports "input" n.inputs <+> Verilog.ports "output" n.outputs
  <+> ");\n" <+> Emit.regDecls 0 n.regs <+> Verilog.nodes 0 n.nodes <+> Emit.regUpdates 0 n.regs
  <+> Verilog.assigns n.outputs <+> "endmodule\n"

def Design.verilog (d : Design) : String := Emit.verilog (Design.netlist d)

-- the host's bit period at 115200 baud and a 12 MHz clock: 625/6 cycles
def Host.num : Nat := 625
def Host.den : Nat := 6

def Scenario.lines : List (List Nat) := Gen.lines Gen.textByte 24 12 2026
def Scenario.binaryLines : List (List Nat) := Gen.lines Gen.anyByte 12 6 7
def Scenario.echoBytes : List Nat := Gen.bytes Gen.anyByte 64 99

-- a reply is three bytes (3120 cycles); the host waits a little longer
def Scenario.gap : Nat := 3400

-- the RX pin, cycle by cycle
def Design.input : Design → List Nat
  | .blinky => Wave.rep 20000 1 .nil
  | .hello => Wave.rep 19000 1 .nil
  -- 64 bytes back to back, then time for the last one to come back
  | .echo => Wave.events Host.num Host.den
      (.cons (Ev.idle 30) (Ev.bytes Scenario.echoBytes (.cons (Ev.idle 1300) .nil)))
  | .proto => Wave.events Host.num Host.den (.cons (Ev.idle 30) (Proto.events Scenario.gap
      (List.append Scenario.lines Scenario.binaryLines)))

-- the bytes the board must send
def Design.expect : Design → List Nat
  | .blinky => .nil
  | .hello => helloText
  | .echo => Scenario.echoBytes
  | .proto => Proto.replies (List.append Scenario.lines Scenario.binaryLines)
