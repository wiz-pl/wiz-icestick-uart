import Icestick.Sphere
-- `blobs`: a sphere tracer on the PmodOLEDrgb. Two balls of radius 12 joined by a smooth
-- minimum, swinging through each other so that they merge and split, in front of a sky
-- (the floor and shadows of `sphere` did not fit next to the tracer).
--
-- The rays are parallel (an orthographic camera looking along +z), so along a ray only
-- z changes. A two-stage pipeline, one pixel every 32 cycles (the time a pixel takes to
-- send), each stage busy with a different pixel:
--
--  * stage A (pixel n + 2): for each ball, ρ = |(dx, dy)|, the distance of the ray from
--    the ball's centre line, exactly (rounded down to half a pixel): five cycles of
--    shift-and-add squaring, a shift (× 4), seven cycles of bit-by-bit square root,
--    one ball after the other (28 cycles);
--  * stage B (pixel n + 1): the march, one step every two cycles (one distance unit,
--    ball 1 then ball 2), 16 steps: z += d until d ≤ 1/2
--    pixel (a hit) or z leaves the scene (a miss). The distance to a ball at depth z is
--    |(ρ, z − cz)| − R, the length estimated from below by max(ρ, |z − cz|, 11/16 (ρ +
--    |z − cz|)) (11/16 < 1/√2: an octagon around the true circle, at most 7.6 % short,
--    so a step never passes through a surface; it is exact where the ray is closest to
--    the centre, so the outlines are exact circles). The two balls are joined by the
--    quadratic smooth minimum smin(a, b) = min(a, b) − max(k − |a − b|, 0)² / (4k),
--    k = 16 pixels, the square from a 17-entry table: no multiplier anywhere.
--
-- Shading: by the nearer ball's normal, (dx, dy, −√(R² − ρ²)) from its ρ and a 25-entry
-- table (not from the march's depth, which the length estimate leaves off), light from
-- the upper left in front: brightness 20 + 3/8 (−nx − ny − 2nz); from brightness 56 the
-- colour runs to white (a small highlight). Ball 1 orange, ball 2 cyan; in the neck
-- the nearer ball's normal lies near its rim, so the neck is darker.
-- Lengths are in quarter pixels, 12-bit two's complement.

def D12 : HwTy := HwTy.bits 12
def D13 : HwTy := HwTy.bits 13
def D14 : HwTy := HwTy.bits 14

def Bl.R : Nat := 48        -- the radius, 12 pixels
def Bl.far : Nat := 640     -- z beyond the scene (160 pixels)
def Bl.z0 : Nat := 128      -- where the rays start (32 pixels: in front of everything)

-- the balls' centres (units: quarter pixels)
structure BScene (r : HwTy → Type) where
  x1 : r D12
  y1 : r D12
  z1 : r D12
  x2 : r D12
  y2 : r D12
  z2 : r D12

-- s − 16 for a sine 0 … 31, as 12 bits
def sgn12 {r : HwTy → Type} [Hw r] (v : r D5) : r D12 := zext 7 v - 16
def q4 {r : HwTy → Type} [Hw r] (v : r D12) : r D12 := Hw.cat (Hw.slice 0 10 v) (Hw.lit 2 0)

-- The balls swing through each other along x (amplitude 16 pixels) while circling in
-- depth at twice the rate (8 pixels) and bobbing (4 pixels) in opposite phase: they
-- merge in the middle and split at the ends, twice an orbit.
def BScene.at {r : HwTy → Type} [Hw r] (t : r D9) : BScene r :=
  let p := Hw.slice 2 6 t;
  let u := sgn12 (sin6 p);
  let w2 := sgn12 (sin6 (Hw.cat (Hw.slice 0 5 p) lo));
  let w := Hw.cat (Hw.slice 11 1 w2) (Hw.slice 1 11 w2);
  let v := zext 9 (Hw.slice 2 3 (sin6 (p + 16))) - 4;
  let c := fun (base : Nat) (d : r D12) => q4 (Hw.lit 12 base + d);
  let m := fun (base : Nat) (d : r D12) => q4 (Hw.lit 12 base - d);
  BScene.mk (c 48 u) (c 22 v) (c 64 w) (m 48 u) (m 22 v) (m 64 w)

def neg12 {r : HwTy → Type} [Hw r] (a : r D12) : r Bit := Hw.slice 11 1 a
def abs12 {r : HwTy → Type} [Hw r] (a : r D12) : r D12 := if neg12 a then -a else a
def max12 {r : HwTy → Type} [Hw r] (a b : r D12) : r D12 := if a <ᵤ b then b else a
def shr1 {r : HwTy → Type} [Hw r] (a : r D12) : r D12 := zext 1 (Hw.slice 1 11 a)
def shr3 {r : HwTy → Type} [Hw r] (a : r D12) : r D12 := zext 3 (Hw.slice 3 9 a)
def shr4 {r : HwTy → Type} [Hw r] (a : r D12) : r D12 := zext 4 (Hw.slice 4 8 a)
-- signed less-than
def slt12 {r : HwTy → Type} [Hw r] (a b : r D12) : r Bit :=
  (a ^^^ 2048) <ᵤ (b ^^^ 2048)
def smin12 {r : HwTy → Type} [Hw r] (a b : r D12) : r D12 := if slt12 a b then a else b

-- the length of (a, c), a, c ≥ 0, from below: max(a, c, 11/16 (a + c))
def norm2 {r : HwTy → Type} [Hw r] (a c : r D12) : r D12 :=
  let s := a + c;
  max12 (max12 a c) (shr1 s + (shr3 s + shr4 s))

-- max(k − |a − b|, 0)² / (4k) with k = 64 units (16 pixels), by g = k − |a − b|
-- quartered (0 … 16): (4i)² / 256
def Bl.corrGo : Nat → Nat → List Nat
  | .zero, g => .nil
  | .succ n, g => .cons (Nat.div (16 * g * g) 256) (Bl.corrGo n (g + 1))
def Bl.corrT : RomT := RomT.build 5 (Bl.corrGo 17 0)

-- ⌊√m⌋, by counting (meta level)
def Bl.isqrt (m : Nat) : Nat → Nat → Nat
  | h, .zero => h
  | h, .succ k => match Nat.le ((h + 1) * (h + 1)) m with
    | .true => Bl.isqrt m (h + 1) k
    | .false => h

------------------------------------------------------------------------------------
-- Stage A: ρ for both balls.

-- the multipliers and the accumulator
structure ASq (r : HwTy → Type) where
  mx : r D5
  my : r D5
  sx : r D10
  sy : r D10
  acc : r D13
  deriving Bundle

-- the square root: h², h · 2^(b+1), 4^b
structure ARoot (r : HwTy → Type) where
  h2 : r D14
  dd : r D14
  ee : r D14
  cnt : r D5
  deriving Bundle

-- the pixel's offsets from the centres (pixels, two's complement), the results
structure AOut (r : HwTy → Type) where
  dx1 : r D8
  dy1 : r D8
  dx2 : r D8
  dy2 : r D8
  rho1 : r D8
  rho2 : r D8
  deriving Bundle

structure StageA (r : HwTy → Type) where
  sq : ASq r
  rt : ARoot r
  out : AOut r
  deriving Bundle

def StageA.init : StageA HwTy.El :=
  StageA.mk (ASq.mk (BitVec.ofNat 5 0) (BitVec.ofNat 5 0) (BitVec.ofNat 10 0) (BitVec.ofNat 10 0) (BitVec.ofNat 13 0))
    (ARoot.mk (BitVec.ofNat 14 0) (BitVec.ofNat 14 0) (BitVec.ofNat 14 0) (BitVec.ofNat 5 31))
    (AOut.mk (BitVec.ofNat 8 0) (BitVec.ofNat 8 0) (BitVec.ofNat 8 0) (BitVec.ofNat 8 0) (BitVec.ofNat 8 255) (BitVec.ofNat 8 255))

def abs8b {r : HwTy → Type} [Hw r] (a : r D8) : r D8 := if Hw.slice 7 1 a then -a else a
def far8 {r : HwTy → Type} [Hw r] (a : r D8) : r Bit := Hw.slice 5 3 (abs8b a) =/= 0

-- cycle 0: start (ball 1's magnitudes in); 1 … 5 square; 6 × 4 and the root's start;
-- 7 … 13 root (half pixels); 14 ρ1 out, ball 2's magnitudes in; 15 … 19 square; 20;
-- 21 … 27 root; 28 ρ2 out; then idle
def stageAStep {r : HwTy → Type} [Hw r] (s : StageA r) (start : r Bit) (tx : r D7) (ty : r D6) (sc : BScene r) : r StageA.code :=
  let px := fun (v : r D12) => Hw.slice 2 8 v;
  let ndx1 := zext 1 tx - px sc.x1;
  let ndy1 := zext 2 ty - px sc.y1;
  let ndx2 := zext 1 tx - px sc.x2;
  let ndy2 := zext 2 ty - px sc.y2;
  let q := s.sq;
  let rt := s.rt;
  let o := s.out;
  let c := rt.cnt;
  let inR := fun (lo hi : Nat) => c ≥ᵤ Hw.ofNat lo &&& c <ᵤ Hw.ofNat (hi + 1);
  let squaring := inR 1 5 ||| inR 15 19;
  let six := c === 6 ||| c === 20;
  let rooting := inR 7 13 ||| inR 21 27;
  let load2 := c === 14;
  let pick := fun (b : r Bit) (v : r D10) => if b then zext 3 v else 0;
  let trial := rt.h2 + (rt.dd + rt.ee);
  let fits := zext 1 q.acc ≥ᵤ trial;
  let shl := fun (v : r D10) => Hw.cat (Hw.slice 0 9 v) lo;
  let shr := fun (v : r D5) => Hw.cat lo (Hw.slice 1 4 v);
  let m1x := Hw.slice 0 5 (abs8b o.dx2);
  let m1y := Hw.slice 0 5 (abs8b o.dy2);
  -- ρ in quarter pixels: twice the root of 4 r²
  let rho := fun (far : r Bit) => if far then 255 else Hw.cat (Hw.slice 0 7 rt.dd) lo;
  StageA.pack (StageA.mk
    (ASq.mk
      (if start then Hw.slice 0 5 (abs8b ndx1) else if load2 then m1x else shr q.mx)
      (if start then Hw.slice 0 5 (abs8b ndy1) else if load2 then m1y else shr q.my)
      (if start then zext 5 (Hw.slice 0 5 (abs8b ndx1)) else if load2 then zext 5 m1x else shl q.sx)
      (if start then zext 5 (Hw.slice 0 5 (abs8b ndy1)) else if load2 then zext 5 m1y else shl q.sy)
      (if start ||| load2 then 0
        else if six then Hw.cat (Hw.slice 0 11 q.acc) (Hw.lit 2 0)
          else q.acc + (pick (Hw.slice 0 1 q.mx) q.sx + pick (Hw.slice 0 1 q.my) q.sy)))
    (ARoot.mk
      (if six then 0 else if rooting &&& fits then trial else rt.h2)
      (if six then 0 else if rooting then
        Hw.cat lo (Hw.slice 1 13 rt.dd) + (if fits then rt.ee else 0) else rt.dd)
      (if six then 4096 else Hw.cat (Hw.lit 2 0) (Hw.slice 2 12 rt.ee))
      (if start then 1 else if c === 31 then c else c + 1))
    (AOut.mk
      (if start then ndx1 else o.dx1) (if start then ndy1 else o.dy1) (if start then ndx2 else o.dx2) (if start then ndy2 else o.dy2)
      (if c === 14 then rho (far8 o.dx1 ||| far8 o.dy1) else o.rho1)
      (if c === 28 then rho (far8 o.dx2 ||| far8 o.dy2) else o.rho2)))

------------------------------------------------------------------------------------
-- Stage B: the march.

structure BIn (r : HwTy → Type) where
  rho1 : r D12
  rho2 : r D12
  l1 : r D12        -- −4 dx1 − 4 dy1 (the shading's x and y part, units)
  l2 : r D12
  deriving Bundle

structure BMarch (r : HwTy → Type) where
  z : r D12
  left : r D5
  hit : r Bit
  done : r Bit
  near1 : r Bit     -- ball 1 is the nearer at the last step
  deriving Bundle

-- the step's two halves: ball 1's distance (first cycle), kept for the second
structure BHalf (r : HwTy → Type) where
  ph : r Bit
  d1 : r D12
  deriving Bundle

structure StageB (r : HwTy → Type) where
  inp : BIn r
  mr : BMarch r
  hf : BHalf r
  deriving Bundle

def StageB.init : StageB HwTy.El :=
  StageB.mk (BIn.mk (BitVec.ofNat 12 1020) (BitVec.ofNat 12 1020) (BitVec.ofNat 12 0) (BitVec.ofNat 12 0))
    (BMarch.mk (BitVec.ofNat 12 0) (BitVec.ofNat 5 0) (BitVec.ofNat 1 0) (BitVec.ofNat 1 1) (BitVec.ofNat 1 1))
    (BHalf.mk (BitVec.ofNat 1 0) (BitVec.ofNat 12 0))

-- one ball's distance at depth z: |(ρ, z − cz)| − R, the length from below
def ballDist {r : HwTy → Type} [Hw r] (rho cz z : r D12) : r D12 :=
  norm2 rho (abs12 (z - cz)) - Hw.ofNat Bl.R

-- the smooth minimum (k = 64 units), less one unit for the rounding
def sminK {r : HwTy → Type} [Hw r] (d1 d2 : r D12) : r D12 :=
  let e := abs12 (d2 - d1);
  let g := if e <ᵤ 64 then Hw.lit 12 64 - e else 0;
  smin12 d1 d2 - zext 7 (Rom.at 5 (Hw.slice 2 5 g) Bl.corrT) - 1

def x4 {r : HwTy → Type} [Hw r] (v : r D8) : r D12 :=
  Hw.cat (Hw.slice 7 1 v) (Hw.cat (Hw.slice 7 1 v) (Hw.cat v (Hw.lit 2 0)))

-- `shift`: take stage A's result (a new pixel) and start marching. A step takes two
-- cycles, one distance unit shared by the balls: ball 1 (ph = 0), then ball 2 and the
-- smooth minimum and the step (ph = 1); 16 steps.
def stageBStep {r : HwTy → Type} [Hw r] (s : StageB r) (shift : r Bit) (a : AOut r) (sc : BScene r) : r StageB.code :=
  let b := s.inp;
  let mr := s.mr;
  let ph := s.hf.ph;
  let dd := ballDist (if ph then b.rho2 else b.rho1) (if ph then sc.z2 else sc.z1) mr.z;
  let d := sminK s.hf.d1 dd;
  let marching := ~~~mr.done &&& ph;
  let close := slt12 d (Hw.lit 12 3);
  let z2 := mr.z + d;
  let gone := z2 ≥ᵤ Hw.ofNat Bl.far ||| mr.left === 1;
  let nl := fun (dx dy : r D8) => -x4 dx - x4 dy;
  StageB.pack (StageB.mk
    (BIn.mk (if shift then zext 4 a.rho1 else b.rho1) (if shift then zext 4 a.rho2 else b.rho2)
      (if shift then nl a.dx1 a.dy1 else b.l1) (if shift then nl a.dx2 a.dy2 else b.l2))
    (BMarch.mk
      (if shift then Hw.lit 12 Bl.z0 else if marching &&& ~~~close then z2 else mr.z)
      (if shift then 16 else if marching then mr.left - 1 else mr.left)
      (if shift then 0 else if marching &&& close then 1 else mr.hit)
      (if shift then 0 else if marching &&& (close ||| gone) then 1 else mr.done)
      (if marching then ~~~(slt12 dd s.hf.d1) else mr.near1))
    (BHalf.mk (if shift then 0 else ~~~ph) (if ph then s.hf.d1 else dd)))

-- the colour of the pixel from stage B's result for it
-- the front of a ball at distance ρ from its centre line: √(R² − ρ²), units, by ρ in
-- half pixels (0 beyond the radius)
def Bl.frontGo : Nat → Nat → List Nat
  | .zero, i => .nil
  | .succ n, i => .cons (Bl.isqrt (Nat.sub 2304 (4 * i * i)) 0 64) (Bl.frontGo n (i + 1))
def Bl.frontT : RomT := RomT.build 5 (Bl.frontGo 25 0)

def blobColor {r : HwTy → Type} [Hw r] (s : StageB r) (sc : BScene r) (x : r D7) (y : r D6) (t : r D9) : r (HwTy.bits 16) :=
  let b := s.inp;
  let n1 := s.mr.near1;
  -- −nx − ny − 2 nz of the nearer ball, nz from its ρ (the sphere's own normal, not
  -- the march's depth, which the length estimate leaves up to 8 % off)
  let rho := if n1 then b.rho1 else b.rho2;
  let idx := if Hw.slice 6 6 rho === 0 then Hw.slice 1 5 rho else 31;
  let front := zext 6 (Rom.at 6 idx Bl.frontT);
  let l := (if n1 then b.l1 else b.l2) + Hw.cat (Hw.slice 0 11 front) lo;
  -- brightness 20 + 3/8 l (l ≤ 117: up to 63), clamped
  let sg := Hw.slice 11 1 l;
  let l4 := Hw.cat sg (Hw.cat sg (Hw.slice 2 10 l));
  let l8 := Hw.cat sg (Hw.cat sg (Hw.cat sg (Hw.slice 3 9 l)));
  let v := Hw.lit 12 20 + (l4 + l8);
  let lum := if neg12 v then 0 else if v <ᵤ 64 then Hw.slice 0 6 v else 63;
  -- the highlight: from brightness 56 up, the colour runs to white (OR-ed in)
  let sp := if Hw.slice 3 3 lum === 7 then Hw.cat (Hw.slice 0 3 lum) lo else 0;
  let orange := rgb565 (Hw.slice 1 5 lum) (Hw.cat lo (Hw.slice 1 5 lum)) (Hw.cat (Hw.lit 2 0) (Hw.slice 3 3 lum));
  let cyan := rgb565 (Hw.cat (Hw.lit 2 0) (Hw.slice 3 3 lum)) lum (Hw.slice 1 5 lum);
  let spec := rgb565 (Hw.cat sp lo) (Hw.cat sp (Hw.lit 2 0)) (Hw.cat sp lo);
  let ball := (if n1 then orange else cyan) ||| spec;
  -- the sky: dark blue at the top to purple at the bottom
  let sky := rgb565 (Hw.slice 1 5 y) (Hw.cat (Hw.lit 2 0) (Hw.slice 2 4 y)) (Hw.lit 5 8 + Hw.cat lo (Hw.slice 2 4 y));
  if s.mr.hit then ball else sky

------------------------------------------------------------------------------------
-- The design.

structure BlobsDemo (fl : Nat) (r : HwTy → Type) where
  ctl : RCtl fl r
  a : StageA r
  b : StageB r
  fdel : r D6        -- cycles since a frame began (stops at 63)
  deriving Bundle

def BlobsDemo.init (c : RgbCfg) : BlobsDemo c.frameLog HwTy.El :=
  BlobsDemo.mk (RCtl.init c) StageA.init StageB.init (BitVec.ofNat 6 63)

-- the pixel k after (x, y), k = 1, 2
def nextPx {r : HwTy → Type} [Hw r] (k : Nat) (x : r D7) (y : r D6) : r (HwTy.prod D7 D6) :=
  let nx := x + Hw.ofNat k;
  let wrap := nx ≥ᵤ Hw.ofNat Rgb.width;
  Hw.pair (if wrap then nx - Hw.ofNat Rgb.width else nx) (if wrap then y + 1 else y)

def blobsStep {r : HwTy → Type} [Hw r] (c : RgbCfg) (rom : RomT) (s : BlobsDemo c.frameLog r) (x : OledPins r)
    : r (HwTy.prod (BlobsDemo.code c.frameLog) RgbBoard.code) :=
  let cs := s.ctl;
  let g := cs.gen;
  let t := Hw.slice 0 9 cs.fr.t;
  let sc := BScene.at t;
  let op := ROp.of (Rom.at 9 cs.sq.pc rom);
  let ready := spiReady cs.spi;
  let frameGo := op.frame &&& (ready &&& (cs.pins.cs &&& cs.fr.pend));
  -- a pixel's high byte goes out: B takes pixel n + 1, A starts n + 2. At a frame's
  -- start: A starts (0, 0) a cycle after the frame counter moved, and 31 cycles later
  -- B takes it and A starts (1, 0).
  let loadHi := (op.blank ||| op.pix) &&& ready &&& ~~~g.half;
  let fStart := s.fdel === 1;
  let fShift := s.fdel === 32;
  let shift := loadHi ||| fShift;
  let n2 := nextPx 2 g.x g.y;
  let tx := if fStart then 0 else if fShift then 1 else Hw.fst n2;
  let ty := if fStart ||| fShift then 0 else Hw.snd n2;
  let color := blobColor s.b sc g.x g.y t;
  let p := cs.pins;
  let bar := Hw.lit 4 1;
  Hw.pair
    (BlobsDemo.pack c.frameLog (BlobsDemo.mk (RCtl.unpack c.frameLog (rctlStep c rom cs color))
      (StageA.unpack (stageAStep s.a (fStart ||| shift) tx ty sc))
      (StageB.unpack (stageBStep s.b shift s.a.out sc))
      (if frameGo then 0 else if s.fdel === 63 then s.fdel else s.fdel + 1)))
    (RgbBoard.pack (RgbBoard.mk hi (Hw.cat (rctlShowing cs) bar)
      p.cs cs.spi.mosi cs.spi.sclk p.dc p.res p.vccen p.pmoden))

def blobsDesign (c : RgbCfg) : Circuit OledPins.code RgbBoard.code :=
  let rom := RProg.tree;
  Circuit.bundled (BlobsDemo.bundle c.frameLog) OledPins.bundle RgbBoard.bundle (BlobsDemo.init c) (blobsStep c rom)
