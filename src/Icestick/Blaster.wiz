import Icestick.Ir
import Icestick.Crc
import Text
-- The IR blaster: a command prompt on the serial port that sends NEC frames through
-- the IrDA transceiver, and reports what the transceiver's receiver decodes.
--
--   ir> on                 LG POWER ON   (NEC address 0x04, command 0xC4)
--   ir> off                LG POWER OFF  (0xC5)
--   ir> power              LG POWER      (0x08, toggles)
--   ir> raw AA CC          NEC address AA, command CC (hex)
--   ir> raw AAAA CC        extended NEC: the two address bytes in the order sent
--   ir> listen             print every frame received, until a key is pressed
--   ir> hold N             follow every frame with N repeat codes (a key held for
--                          N × 108 ms); with 0, `power` alone sends 4
--   ir> help
--
-- After a frame the board answers `sent 04 FB C4 3B (20DF23DC) +0, echo ok`: the four
-- bytes in the order sent, the 32 bits with the first one sent on top (the usual way of
-- writing NEC codes), the number of repeat codes after it, and whether the decoder saw that very frame come back (the
-- TFDU4101 echoes what it sends on its receive pin). Typed characters are echoed;
-- backspace and ^C work; a line ends with CR or LF (CR LF counts once). Bytes that
-- arrive while the board is answering are dropped.
--
-- LEDs: LED1 sending, LED2 receiving (a leader seen), LED3 listening, LED4 the last frame
-- sent came back, LED5 (green) on.

def B77 : HwTy := HwTy.bits 77

structure IrPins (r : HwTy → Type) where
  uart_rx : r Bit
  ir_rx : r Bit
  deriving Bundle

structure IrBoard (r : HwTy → Type) where
  uart_tx : r Bit
  leds : r B5
  ir_tx : r Bit
  ir_sd : r Bit
  deriving Bundle

------------------------------------------------------------------------------------
-- What the board says: a read-only memory of 7-bit codes. 0: stop; 1: continue at OK
-- or NOECHO (did the frame come back?); 2: continue at the prompt; 3: the number of
-- repeat codes (a digit); 4: wait until the encoder is done; 16 + j: hex digit j of the bytes of `shown` in the order sent (digit
-- 0 is the high nibble of the first byte); 24 + j: hex digit j of the 32 bits reversed
-- (digit 0 on top); any other code: that character (BS, LF, CR and 32 … 126 are used).

def Txt.codesOf : List Char → List Nat
  | .nil => .nil
  | .cons c cs => .cons (Char.code c) (Txt.codesOf cs)
def Txt.codes (s : String) : List Nat := Txt.codesOf (String.chars s)

def Pr.cond : Nat := 1
def Pr.prompt : Nat := 2
def Pr.wait : Nat := 4
def Pr.reps : Nat := 3

def Pr.crlf (rest : List Nat) : List Nat := .cons 13 (.cons 10 rest)
def Pr.text (s : String) (rest : List Nat) : List Nat := List.append (Txt.codes s) rest
def Pr.one (c : Nat) (rest : List Nat) : List Nat := .cons c rest
-- "04 FB C4 3B"
def Pr.bytes (rest : List Nat) : List Nat :=
  .cons 16 (.cons 17 (.cons 32 (.cons 18 (.cons 19 (.cons 32 (.cons 20 (.cons 21 (.cons 32
  (.cons 22 (.cons 23 rest))))))))))
-- "20DF23DC"
def Pr.scan (rest : List Nat) : List Nat :=
  .cons 24 (.cons 25 (.cons 26 (.cons 27 (.cons 28 (.cons 29 (.cons 30 (.cons 31 rest)))))))
-- "04 FB C4 3B (20DF23DC)"
def Pr.frame (rest : List Nat) : List Nat := Pr.bytes (Pr.text " (" (Pr.scan (Pr.one 41 rest)))

def Msg.banner : List Nat := Pr.crlf (Pr.text "IR blaster. help" (Pr.crlf (Pr.one Pr.prompt .nil)))
def Msg.prompt : List Nat := Pr.text "ir> " (Pr.one 0 .nil)
def Msg.help : List Nat := Pr.crlf (Pr.text "on off power raw listen hold N" (Pr.crlf (Pr.one Pr.prompt .nil)))
def Msg.sent : List Nat := Pr.crlf (Pr.one Pr.wait (Pr.text "sent " (Pr.frame (Pr.text " +" (Pr.one Pr.reps (Pr.one Pr.cond .nil))))))
def Msg.ok : List Nat := Pr.text ", echo ok" (Pr.crlf (Pr.one Pr.prompt .nil))
def Msg.noecho : List Nat := Pr.text ", no echo" (Pr.crlf (Pr.one Pr.prompt .nil))
def Msg.unknown : List Nat := Pr.crlf (Pr.text "? (help)" (Pr.crlf (Pr.one Pr.prompt .nil)))
def Msg.listen : List Nat := Pr.crlf (Pr.text "listening" (Pr.crlf (Pr.one 0 .nil)))
def Msg.rx : List Nat := Pr.text "rx " (Pr.frame (Pr.crlf (Pr.one 0 .nil)))
def Msg.rxrep : List Nat := Pr.text "rx repeat" (Pr.crlf (Pr.one 0 .nil))
def Msg.nl : List Nat := Pr.crlf (Pr.one Pr.prompt .nil)
def Msg.bs : List Nat := .cons 8 (.cons 32 (.cons 8 (.cons 0 .nil)))
def Msg.ctrlc : List Nat := Pr.text "^C" (Pr.crlf (Pr.one Pr.prompt .nil))
def Msg.hold : List Nat := Pr.crlf (Pr.text "hold " (Pr.one Pr.reps (Pr.crlf (Pr.one Pr.prompt .nil))))

def Msg.list : List (List Nat) :=
  .cons Msg.banner (.cons Msg.prompt (.cons Msg.help (.cons Msg.sent (.cons Msg.ok (.cons Msg.noecho
  (.cons Msg.unknown (.cons Msg.listen (.cons Msg.rx (.cons Msg.rxrep (.cons Msg.nl (.cons Msg.bs
  (.cons Msg.ctrlc (.cons Msg.hold .nil)))))))))))))

def Msg.offset : Nat → List (List Nat) → Nat
  | .zero, _ => 0
  | .succ k, .nil => 0
  | .succ k, .cons m ms => List.length m + Msg.offset k ms
def Msg.concat : List (List Nat) → List Nat
  | .nil => .nil
  | .cons m ms => List.append m (Msg.concat ms)

def Msg.rom : List Nat := Msg.concat Msg.list
def Msg.at (k : Nat) : Nat := Msg.offset k Msg.list
def Msg.BANNER : Nat := Msg.at 0
def Msg.PROMPT : Nat := Msg.at 1
def Msg.HELP : Nat := Msg.at 2
def Msg.SENT : Nat := Msg.at 3
def Msg.OK : Nat := Msg.at 4
def Msg.NOECHO : Nat := Msg.at 5
def Msg.UNKNOWN : Nat := Msg.at 6
def Msg.LISTEN : Nat := Msg.at 7
def Msg.RX : Nat := Msg.at 8
def Msg.RXREP : Nat := Msg.at 9
def Msg.NL : Nat := Msg.at 10
def Msg.BS : Nat := Msg.at 11
def Msg.CTRLC : Nat := Msg.at 12
def Msg.HOLD : Nat := Msg.at 13

-- A ROM with an 8-bit address and 7-bit entries: a chain of multiplexers, one per entry.
-- (A tree on the address bits is what yosys would like better, but it costs the value
-- simulation several times the work per cycle.)
def rom8 {r : HwTy → Type} [Hw r] (idx : r B8) : Nat → List Nat → r B7
  | _, .nil => Hw.lit 7 0
  | k, .cons c cs => if idx === Hw.ofNat k then Hw.ofNat c else rom8 idx (Nat.succ k) cs

-- hex digit j (of 8) of the bytes in the order sent, and of a 32-bit number
def byteNib {r : HwTy → Type} [Hw r] (w : r B32) (j : Nat) : r B4 :=
  Hw.slice (8 * Nat.div j 2 + 4 * (1 - Nat.mod j 2)) 4 w
def wordNib {r : HwTy → Type} [Hw r] (w : r B32) (j : Nat) : r B4 := Hw.slice (28 - 4 * j) 4 w
def pick8 {r : HwTy → Type} [Hw r] (sel : r B3) (f : Nat → r B4) : Nat → r B4
  | .zero => f 0
  | .succ k => if sel === Hw.ofNat (Nat.succ k) then f (Nat.succ k) else pick8 sel f k

------------------------------------------------------------------------------------
-- The command line: the last eleven characters typed (7-bit ASCII), the newest at the
-- bottom, and
-- how many there are (up to 15: a longer line is no command).

def chAt {r : HwTy → Type} [Hw r] (line : r B77) (k : Nat) : r B7 := Hw.slice (7 * k) 7 line

-- the characters `cs` at positions k, k-1, …
def textAt {r : HwTy → Type} [Hw r] (line : r B77) : Nat → List Nat → r Bit
  | k, .nil => hi
  | k, .cons c cs => chAt line k === Hw.ofNat c &&& textAt line (k - 1) cs

def isWord {r : HwTy → Type} [Hw r] (line : r B77) (len : r B4) (w : String) : r Bit :=
  len === Hw.ofNat (List.length (Txt.codes w)) &&& textAt line (List.length (Txt.codes w) - 1) (Txt.codes w)

-- hexadecimal digits, either case (bit tests: a comparison with a constant would take
-- a carry chain)
def table4 {r : HwTy → Type} [Hw r] {ω w : Nat} (x : r B4) (f : Nat → Nat) : Nat → r (HwTy.bits w)
  | .zero => Hw.lit w (f 0)
  | .succ k => if x === Hw.ofNat (Nat.succ k) then Hw.ofNat (f (Nat.succ k)) else table4 x f k
def hexOk {r : HwTy → Type} [Hw r] (c : r B7) : r Bit :=
  let lo4 := Hw.slice 0 4 c;
  let hi3 := Hw.slice 4 3 (c ||| 32);
  if hi3 === 3 then table4 lo4 (fun (k : Nat) => Nat.ofBool (Nat.lt k 10)) 15
    else hi3 === 6 &&& table4 lo4 (fun (k : Nat) => Nat.ofBool (Bool.and (Nat.lt 0 k) (Nat.lt k 7))) 15
-- (a letter has bit 6 set, a digit not)
def hexVal {r : HwTy → Type} [Hw r] (c : r B7) : r B4 :=
  if Hw.slice 6 1 c then table4 (Hw.slice 0 4 c) (fun (k : Nat) => Nat.mod (k + 9) 16) 15 else Hw.slice 0 4 c
-- an upper-case hex digit
def hexChar {r : HwTy → Type} [Hw r] (nib : r B4) : r B8 := table4 nib Crc.hex 15
-- the byte written at positions k, k-1
def hexByte {r : HwTy → Type} [Hw r] (line : r B77) (k : Nat) : r B8 :=
  Hw.cat (hexVal (chAt line k)) (hexVal (chAt line (k - 1)))
def hexAt {r : HwTy → Type} [Hw r] (line : r B77) : List Nat → r Bit
  | .nil => hi
  | .cons k ks => hexOk (chAt line k) &&& hexAt line ks

------------------------------------------------------------------------------------
-- The design.

-- The state, in four groups (a structure with many fields is slow for the Wiz compiler):
-- the line being typed and a character to echo; the printer and the mode; the frame
-- shown or sent, the repeat codes, and how the echo compares.
structure Ed (r : HwTy → Type) where
  line : r B77
  len : r B4
  cr : r Bit
  pend : r Bit
  ech : r B8
  deriving Bundle
structure Pt (r : HwTy → Type) where
  pc : r B8
  busy : r Bit
  listen : r Bit
  deriving Bundle
structure Fr (r : HwTy → Type) where
  shown : r B32
  seen : r Bit
  hold : r B4
  reps : r B4
  same : r Bit
  deriving Bundle

structure Blaster (r : HwTy → Type) where
  sync : Sync r
  rx : Rx r
  tx : Tx r
  ed : Ed r
  pt : Pt r
  fr : Fr r
  enc : NecTx r
  dec : NecRx r
  deriving Bundle

def Blaster.init : Blaster HwTy.El :=
  Blaster.mk Sync.init Rx.init Tx.init
    (Ed.mk (BitVec.ofNat 77 0) (BitVec.ofNat 4 0) (BitVec.ofNat 1 0) (BitVec.ofNat 1 0) (BitVec.ofNat 8 0))
    (Pt.mk (BitVec.ofNat 8 Msg.BANNER) (BitVec.ofNat 1 1) (BitVec.ofNat 1 0))
    (Fr.mk (BitVec.ofNat 32 0) (BitVec.ofNat 1 0) (BitVec.ofNat 4 0) (BitVec.ofNat 4 0) (BitVec.ofNat 1 0))
    NecTx.init NecRx.init

def lit8 {r : HwTy → Type} [Hw r] (k : Nat) : r B8 := Hw.lit 8 k

-- What the line says (looked at when it ends): a frame to send (its word and repeat
-- codes), help, listen, or hold N. (A function of its own: the Wiz compiler takes much
-- longer over one big step function than over several small ones.)
structure Cmd (r : HwTy → Type) where
  send : r Bit
  help : r Bit
  listen : r Bit
  hold : r Bit
  holdN : r B4
  word : r B32
  reps : r B4
  deriving Bundle

def parseLine {r : HwTy → Type} [Hw r] (ln : r B77) (len hold : r B4) : r Cmd.code :=
  let cOn := isWord ln len "on";
  let cOff := isWord ln len "off";
  let cPower := isWord ln len "power";
  let cHelp := isWord ln len "help" ||| isWord ln len "?";
  let cListen := isWord ln len "listen";
  let sp2 := chAt ln 2 === 32;
  let raw11 := len === 11 &&& (textAt ln 10 (Txt.codes "raw ") &&& (sp2 &&&
    hexAt ln (.cons 6 (.cons 5 (.cons 4 (.cons 3 (.cons 1 (.cons 0 .nil))))))));
  let raw9 := len === 9 &&& (textAt ln 8 (Txt.codes "raw ") &&& (sp2 &&&
    hexAt ln (.cons 4 (.cons 3 (.cons 1 (.cons 0 .nil))))));
  let cRaw := raw11 ||| raw9;
  -- "hold N": every frame from now on is followed by N repeat codes (0: none, except
  -- `power`, which then sends 4: some TVs act on the power key only when it is held)
  let c0 := chAt ln 0;
  let cHold := len === 6 &&& (textAt ln 5 (Txt.codes "hold ") &&&
    (Hw.slice 4 3 c0 === 3 &&& table4 (Hw.slice 0 4 c0) (fun (k : Nat) => Nat.ofBool (Nat.lt k 10)) 15));
  let a0 := if raw11 then hexByte ln 6 else if raw9 then hexByte ln 4 else lit8 Lg.addr;
  let a1 := if raw11 then hexByte ln 4 else if raw9 then ~~~(hexByte ln 4) else lit8 (255 - Lg.addr);
  let cmd := if cRaw then hexByte ln 1 else if cOn then lit8 Lg.on else if cOff then lit8 Lg.off else lit8 Lg.power;
  Cmd.pack (Cmd.mk (cOn ||| (cOff ||| (cPower ||| cRaw))) cHelp cListen cHold (Hw.slice 0 4 c0)
    (necWordX a0 a1 cmd) (if cPower &&& hold === 0 then 4 else hold))

-- What a byte typed at the prompt means (taken only while the board is not answering
-- and not listening).
structure Key (r : HwTy → Type) where
  eol : r Bit
  bs : r Bit
  ctrlC : r Bit
  printable : r Bit
  cr : r Bit
  ch : r B7
  deriving Bundle

def keyStep {r : HwTy → Type} [Hw r] (valid : r Bit) (data : r B8) (take lastCr lenZero : r Bit) : r Key.code :=
  let c := Hw.slice 0 7 data;
  let acc := valid &&& (~~~(Hw.slice 7 1 data) &&& take);
  let isCr := c === 13;
  Key.pack (Key.mk
    (acc &&& (isCr ||| (c === 10 &&& ~~~lastCr)))
    (acc &&& ((c === 8 ||| c === 127) &&& ~~~lenZero))
    (acc &&& c === 3)
    -- 32 … 126
    (acc &&& ((Hw.slice 6 1 c ||| Hw.slice 5 1 c) &&& c =/= 127))
    isCr c)

-- The printer, one step: the character to send (if `send`), and the next address.
structure Prn (r : HwTy → Type) where
  send : r Bit
  ch : r B8
  next : r B8
  stop : r Bit
  deriving Bundle

def prnStep {r : HwTy → Type} [Hw r] (pc : r B8) (busy ready seen encBusy : r Bit) (shown : r B32) (reps : r B4) : r Prn.code :=
  let code := rom8 pc 0 Msg.rom;
  let isEnd := code === 0;
  let emit := ~~~(isEnd ||| (code === Hw.ofNat Pr.cond ||| (code === Hw.ofNat Pr.prompt ||| code === Hw.ofNat Pr.wait)));
  let sendCh := busy &&& (emit &&& ready);
  let sel := Hw.slice 0 3 code;
  let nib := if Hw.slice 3 1 code then pick8 sel (wordNib (scan32 shown)) 7 else pick8 sel (byteNib shown) 7;
  Prn.pack (Prn.mk sendCh
    (if Hw.slice 4 3 code === 1 then hexChar nib
      else if code === Hw.ofNat Pr.reps then Hw.cat (Hw.lit 4 3) reps else Hw.cat (Hw.lit 1 0) code)
    (if sendCh then pc + 1
      else if code === Hw.ofNat Pr.cond then (if seen then lit8 Msg.OK else lit8 Msg.NOECHO)
      else if code === Hw.ofNat Pr.prompt then lit8 Msg.PROMPT
      else if code === Hw.ofNat Pr.wait &&& ~~~encBusy then pc + 1 else pc)
    isEnd)

-- Which message an event starts.
def msgFor {r : HwTy → Type} [Hw r] (eol empty help listen send hold stop bs ctrlC rxShow : r Bit) : r B8 :=
  if eol then
    (if empty then lit8 Msg.NL else if help then lit8 Msg.HELP else if listen then lit8 Msg.LISTEN
      else if send then lit8 Msg.SENT else if hold then lit8 Msg.HOLD else lit8 Msg.UNKNOWN)
    else if stop then lit8 Msg.NL else if bs then lit8 Msg.BS else if ctrlC then lit8 Msg.CTRLC
      else if rxShow then lit8 Msg.RX else lit8 Msg.RXREP

-- (The step is cut into the functions above: the Wiz compiler takes much longer over
-- one big function than over several small ones.)
def blasterStep {r : HwTy → Type} [Hw r] (cfg : IrCfg) (n : Nat) (s : Blaster r) (x : IrPins r) :
    r (HwTy.prod Blaster.code IrBoard.code) :=
  let rr := rxStep n s.rx s.sync.ff2;
  let got := Byte.unpack (Hw.snd rr);
  let dr := necRxStep cfg s.dec x.ir_rx;
  let dg := NecBit.unpack (Hw.snd dr);
  let k := Key.unpack (keyStep got.valid got.data (~~~s.pt.listen &&& ~~~s.pt.busy) s.ed.cr (s.ed.len === 0));
  let stop := got.valid &&& s.pt.listen;
  let pl := Cmd.unpack (parseLine s.ed.line s.ed.len s.fr.hold);
  let sendNow := k.eol &&& pl.send;
  let setHold := k.eol &&& pl.hold;
  -- frames received while listening
  let quiet := s.pt.listen &&& (~~~s.pt.busy &&& ~~~got.valid);
  let rxShow := quiet &&& dg.frame;
  let rxRep := quiet &&& dg.rpt;
  -- the bits of a frame coming in, one by one, against the frame sent
  let same := (dg.idx === 0 ||| s.fr.same) &&& dg.val === bitAt s.fr.shown dg.idx 31;
  let startMsg := k.eol ||| (stop ||| (k.bs ||| (k.ctrlC ||| (rxShow ||| rxRep))));
  let pr := Prn.unpack (prnStep s.pt.pc s.pt.busy (txIdle s.tx &&& ~~~s.ed.pend) s.fr.seen s.enc.busy s.fr.shown s.fr.reps);
  -- the transmitter: an echoed character first
  let echoGo := s.ed.pend &&& txIdle s.tx;
  Hw.pair
    (Blaster.pack (Blaster.mk (Sync.unpack (syncStep s.sync x.uart_rx)) (Rx.unpack (Hw.fst rr))
      (Tx.unpack (txStep n s.tx (echoGo ||| pr.send) (if s.ed.pend then s.ed.ech else pr.ch)))
      (Ed.mk
        (if k.bs then Hw.cat (Hw.lit 7 0) (Hw.slice 7 70 s.ed.line) else if k.printable then Hw.cat (Hw.slice 0 70 s.ed.line) k.ch else s.ed.line)
        (if k.eol ||| k.ctrlC then 0 else if k.bs then s.ed.len - 1
        else if k.printable &&& s.ed.len =/= 15 then s.ed.len + 1 else s.ed.len)
        (if got.valid then k.cr else s.ed.cr)
        (if k.printable then 1 else if echoGo then 0 else s.ed.pend)
        (if k.printable then got.data else s.ed.ech))
      (Pt.mk
        (if startMsg then msgFor k.eol (s.ed.len === 0) pl.help pl.listen pl.send pl.hold stop k.bs k.ctrlC rxShow
        else if s.pt.busy then pr.next else s.pt.pc)
        (if startMsg then 1 else if pr.stop then 0 else s.pt.busy)
        (if k.eol &&& pl.listen then 1 else if stop then 0 else s.pt.listen))
      (Fr.mk
        (if sendNow then pl.word else if s.pt.listen &&& dg.bitv then shr32 s.fr.shown dg.val else s.fr.shown)
        (if sendNow then 0 else if dg.frame &&& same then 1 else s.fr.seen)
        (if setHold then pl.holdN else s.fr.hold)
        (if setHold then pl.holdN else if sendNow then pl.reps else s.fr.reps)
        (if dg.bitv then same else s.fr.same))
      (NecTx.unpack (necTxStep cfg s.enc sendNow (if sendNow then pl.word else s.fr.shown) pl.reps))
      (NecRx.unpack (Hw.fst dr))))
    (IrBoard.pack (IrBoard.mk s.tx.line
      (Hw.cat hi (Hw.cat s.fr.seen (Hw.cat s.pt.listen (Hw.cat (s.dec.ph =/= 0) s.enc.busy))))
      s.enc.out lo))

def blaster (cfg : IrCfg) (n : Nat) : Circuit IrPins.code IrBoard.code :=
  Circuit.bundled Blaster.bundle IrPins.bundle IrBoard.bundle Blaster.init (blasterStep cfg n)
