-- test: run
import Icestick.Crc
import IO
-- The hardware CRC step (`crcStep`, at values) against the specification on numbers
-- (`Crc.step`), for every CRC value and every byte; and the specification against the
-- check value of CRC-8/SMBUS, 0xF4 for "123456789".

def hwStep (c d : Nat) : Nat :=
  BitVec.toNat (@crcStep HwTy.El _ (BitVec.ofNat 8 c) (BitVec.ofNat 8 d))
def hwHex (n : Nat) : Nat := BitVec.toNat (@hexDigit HwTy.El _ (BitVec.ofNat 4 n))

-- the number of (c, d) with c < cs, d < 256 where the two agree
def agreeRow (c : Nat) : Nat → Nat → Nat
  | .zero, acc => acc
  | .succ d, acc => agreeRow c d (acc + Nat.ofBool (Nat.beq (hwStep c d) (Crc.step c d)))
def agree : Nat → Nat → Nat
  | .zero, acc => acc
  | .succ c, acc => agree c (agreeRow c 256 acc)

def hexAgree : Nat → Nat → Nat
  | .zero, acc => acc
  | .succ n, acc => hexAgree n (acc + Nat.ofBool (Nat.beq (hwHex n) (Crc.hex n)))

def digits : List Nat :=
  .cons 49 (.cons 50 (.cons 51 (.cons 52 (.cons 53 (.cons 54 (.cons 55 (.cons 56 (.cons 57 .nil))))))))

def main : IO Unit := do
  IO.println ("crcStep = Crc.step on " <+> Nat.show (agree 256 0) <+> " of 65536 inputs");
  IO.println ("hexDigit = Crc.hex on " <+> Nat.show (hexAgree 16 0) <+> " of 16 inputs");
  IO.println ("CRC-8 of \"123456789\": " <+> Nat.show (Crc.ofList 0 digits) <+> " (0xF4 = 244)")
